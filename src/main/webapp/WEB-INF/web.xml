<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <listener>
        <listener-class>com.project.listener.AppContextListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>MatchRegistrationServlet</servlet-name>
        <servlet-class>com.project.controller.MatchRegistrationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MatchRegistrationServlet</servlet-name>
        <url-pattern>/new-match</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MatchCollectionServlet</servlet-name>
        <servlet-class>com.project.controller.MatchCollectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MatchCollectionServlet</servlet-name>
        <url-pattern>/matches</url-pattern>
    </servlet-mapping>
</web-app>